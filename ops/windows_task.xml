<?xml version="1.0" encoding="UTF-16"?>
<!-- Import with: schtasks /Create /TN "swingbot scan" /XML windows_task.xml
     Duplicate for manage (09:35, 13:35, 15:45) and report (17:00). Times are local; set the host to Eastern Time. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>swingbot daily scan after the close</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-05T16:15:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek><Monday/><Tuesday/><Wednesday/><Thursday/><Friday/></DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>false</StartWhenAvailable>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\swingbot\.venv\Scripts\swingbot.exe</Command>
      <Arguments>--config C:\swingbot\config scan</Arguments>
      <WorkingDirectory>C:\swingbot</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
