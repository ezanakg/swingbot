# Copy to .env and fill in. NEVER commit .env. All secrets are read from the environment only.

# --- run mode -------------------------------------------------------------------------------------
MODE=paper                                   # paper (default) | live
# Both of the following are REQUIRED for MODE=live; the bot refuses to start otherwise.
LIVE_TRADING_ACK=                            # must equal: I_UNDERSTAND_THE_RISKS
LIVE_ALLOWED_SYMBOLS=                        # comma-separated subset of config/universe.yaml watchlist, e.g. AAPL,MSFT,SPY

# --- Robinhood credentials (required for live; optional for paper if data providers are yfinance) --
RH_USERNAME=
RH_PASSWORD=
RH_TOTP_SECRET=                              # base32 seed from Robinhood's authenticator-app setup
RH_SESSION_DIR=var/session                   # directory for the (encrypted) session pickle; created with 0700
SESSION_ENC_KEY=                             # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AUTH_APPROVAL_TIMEOUT_SEC=120

# --- safety ----------------------------------------------------------------------------------------
KILL_SWITCH_PATH=var/KILL_SWITCH             # if this file exists, every mode exits after reconciliation without placing orders

# --- alerts (optional) -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- overrides (optional) --------------------------------------------------------------------------
SWINGBOT_CONFIG_DIR=config
SWINGBOT_DB_PATH=
SWINGBOT_DATA_DIR=
SWINGBOT_LOG_DIR=
LOG_LEVEL=INFO
