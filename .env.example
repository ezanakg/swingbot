# Copy to .env and fill in. NEVER commit .env. All secrets are read from the environment only.

# --- run mode -------------------------------------------------------------------------------------
MODE=paper                                   # paper (default) | live
# Both of the following are REQUIRED for MODE=live; the bot refuses to start otherwise.
LIVE_TRADING_ACK=                            # must equal: I_UNDERSTAND_THE_RISKS
LIVE_ALLOWED_SYMBOLS=                        # comma-separated subset of config/universe.yaml watchlist, e.g. AAPL,MSFT,SPY

# --- Robinhood connection (live only) ---------------------------------------------------------------
RH_ADAPTER=robinhood_mcp                     # robinhood_mcp (official agentic-trading MCP server, default) | robin_stocks (unofficial web API)
RH_SESSION_DIR=var/session                   # directory for the encrypted credential/session files; created with 0700
SESSION_ENC_KEY=                             # Fernet key, REQUIRED for robinhood_mcp: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
RH_AGENTIC_ACCOUNT=                          # optional: last digits of the Agentic account to trade when you have more than one
AUTH_APPROVAL_TIMEOUT_SEC=120

# --- robin_stocks adapter only (unofficial web API; not needed for robinhood_mcp) -------------------
RH_USERNAME=
RH_PASSWORD=
RH_TOTP_SECRET=                              # base32 seed from Robinhood's authenticator-app setup

# --- safety ----------------------------------------------------------------------------------------
KILL_SWITCH_PATH=var/KILL_SWITCH             # if this file exists, every mode exits after reconciliation without placing orders

# --- alerts (optional) -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- overrides (optional) --------------------------------------------------------------------------
SWINGBOT_CONFIG_DIR=config
SWINGBOT_DB_PATH=
SWINGBOT_DATA_DIR=
SWINGBOT_LOG_DIR=
LOG_LEVEL=INFO
